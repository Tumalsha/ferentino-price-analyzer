# Public URL of the deployed Ferentino backend API
# Leave blank when the API is deployed in this same Vercel project.
VITE_API_URL=

# MongoDB Atlas connection string used by the Vercel API function.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ferentino

# Keep these server-only values out of VITE_ variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
